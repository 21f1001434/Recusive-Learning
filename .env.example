# Optional: point to an external .env when VS Code/Bun is launched from another folder.
# HIP_ENV_FILE=C:\path\to\your\.env

# Optional: only needed if AIA fallback or HIP API execution is enabled.
# AIA_ENDPOINT=https://aia.gateway.dell.com/.../chat/completions
# OPENAI_BASE_URL=https://aia.gateway.dell.com/...
# AIA_TOKEN=
# CLIENT_ID=
# CLIENT_SECRET=
# HIP_API_TOKEN=

# Existing Dell AIA env names are also supported directly.
# You do NOT need to rename these to AIA_* variables.
USE_DELL_SSO=true
DELL_AUTH_MODE=auto
MODEL_NAME=gpt-oss-120b
# v2.2.2: no client-side output-token cap is sent by default for text or vision.
# Leave these blank for the deployment/gateway native allowance. Set a positive
# integer only when your Dell AIA deployment explicitly requires a client cap.
AIA_MAX_OUTPUT_TOKENS=
AIA_TEXT_MAX_OUTPUT_TOKENS=
AIA_VISION_MAX_OUTPUT_TOKENS=
BASE_URL=https://aia.gateway.dell.com/genai/dev/v1
TEMPERATURE=0.2
CLIENT_ID=
CLIENT_SECRET=

# Optional explicit switch. Not required when BASE_URL/MODEL_NAME/client credentials exist.
HIP_USE_LLM_FORM_PLANNER=true
AIA_USE_AUTOGEN=true

# Strict section-by-section judge gate
# Text/state judge uses MODEL_NAME=gpt-oss-120b and the same Dell AIA auth.
HIP_SECTION_JUDGE=true
HIP_REQUIRE_TEXT_JUDGE=true
HIP_REQUIRE_VISION_JUDGE=true
HIP_SECTION_JUDGE_MAX_REPAIRS=2
HIP_SECTION_JUDGE_FAIL_CLOSED=true

# Must be a Dell AIA multimodal/vision-capable deployment.
# The code also accepts AIA_VISION_MODEL, VISION_MODEL_NAME, or VISION_MODEL.
VISION_MODEL_NAME=gemma-3-27b-it
# Equivalent aliases also supported: HIP_VISION_MODEL, AIA_VISION_MODEL, VISION_MODEL, GEMMA_MODEL_NAME, GEMMA_MODEL
# Optional separate endpoint. When empty, BASE_URL/AIA_BASE_URL is reused.
HIP_VISION_ENDPOINT=

# HIP Portal form exploration agent (optional overrides; config.yaml defaults enable it)
HIP_FORM_EXPLORATION_FORM_KNOWLEDGE_AGENT_ENABLED=true
HIP_FORM_EXPLORATION_EXPLORE_PARENT_VALUE_BRANCHES=true
HIP_FORM_EXPLORATION_MAX_PARENT_CONTROLS=24
HIP_FORM_EXPLORATION_MAX_VALUES_PER_PARENT=30
HIP_FORM_EXPLORATION_SETTLE_MS=700
HIP_FORM_EXPLORATION_USE_LLM_DEPENDENCY_ANALYST=true
HIP_FORM_EXPLORATION_FAIL_CLOSED_ON_RESTORE_ERROR=false

# Persistent HIP Portal long-term brain is configured in config.yaml under `brain:`.
# The brain reuses MODEL_NAME/BASE_URL/CLIENT_ID/CLIENT_SECRET for text judging.
# Configure a real multimodal model for strict vision-gated memory promotion:
# VISION_MODEL_NAME=gemma-3-27b-it
# Equivalent aliases also supported: HIP_VISION_MODEL, AIA_VISION_MODEL, VISION_MODEL, GEMMA_MODEL_NAME, GEMMA_MODEL

# Keep false for live runs. Set true only for offline unit tests.
HIP_SKIP_VISION_CAPABILITY_PROBE=false

# Vision model resolution (July 16 runtime fix)
# Existing BASE_URL and Dell AIA SSO/client credentials are reused automatically.
# Prefer setting the exact deployment when known:
# HIP_VISION_MODEL=gemma-3-27b-it
# Older projects may use GEMMA_MODEL_NAME or GEMMA_MODEL; both are supported.
# When no explicit model is set, the agent capability-probes bounded reviewed
# candidates (gemma-3-27b-it, then pixtral-12b-2409) before opening HIP.
HIP_VISION_AUTO_DISCOVERY=true
# Optional custom ordered candidates:
# HIP_VISION_AUTO_CANDIDATES=gemma-3-27b-it,pixtral-12b-2409
# Optional MLflow remote tracking server. Leave unset to use MLflow default.
MLFLOW_TRACKING_URI=
# Native MLflow async metric/param/tag queue. V238 also enables this from config.
MLFLOW_ENABLE_ASYNC_LOGGING=true

